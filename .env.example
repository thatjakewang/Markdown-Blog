# Copy to .env and fill in real values. See README.md for details.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/dbname

# API key required by all protected (write) endpoints via the x-api-key header.
# This is the *machine* half of auth: iPhone Shortcuts and automated collectors.
SHORTCUT_API_KEY=your_api_key

# --- Browser login (the *human* half of auth) --------------------------------
# Generate both of the values below with:
#
#     python -m app.auth
#
# Key used to sign the session cookie. Changing it signs everyone out.
SESSION_SECRET=your_session_secret
# scrypt hash of your password, as 'scrypt$<salt_hex>$<hash_hex>'. The plaintext
# password is never stored anywhere.
ADMIN_PASSWORD_HASH=scrypt$...$...
# Set to false ONLY for local http development — with true (the default) the
# browser refuses to send the cookie back over http and login never sticks.
SESSION_COOKIE_SECURE=true
# How long a session lasts, in seconds. Default is 14 days.
# SESSION_MAX_AGE=1209600

# Timezone used for "today" calculations
APP_TIMEZONE=Asia/Taipei

# Seed odometer value, used only until the first POST /api/tesla/odometer
TESLA_ODOMETER_KM=21471
